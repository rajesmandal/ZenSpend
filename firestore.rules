rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }
    function isMember(hid) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.status == 'ACTIVE';
    }
    function isOwner(hid) {
      return isMember(hid) &&
        get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.role == 'OWNER';
    }

    match /users/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow create, update: if isAuthed() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if isAuthed() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isOwner(hid);

      match /members/{memberUid} {
        allow read: if isMember(hid);
        allow write: if false;
      }

      match /invitations/{invId} {
        allow read: if isOwner(hid);
        allow create: if isOwner(hid);
        allow update, delete: if isOwner(hid);
      }

      match /transactions/{docId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.householdId == hid;
        allow update: if isMember(hid)
          && request.resource.data.updatedByUserId == request.auth.uid;
      }

      match /wallets/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /categories/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /budgets/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /creditCards/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /emis/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /recurringTransactions/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }
    }
  }
}
