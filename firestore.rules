rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }
    function isMember(hid) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.status == 'ACTIVE';
    }
    function isOwner(hid) {
      return isMember(hid) &&
        get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.role == 'OWNER';
    }

    match /users/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow create, update: if isAuthed() && request.auth.uid == uid;
    }

    // Invitations live at the top level; the document id is the SHA-256 of the secret token,
    // so only someone holding the token can `get` it. Joining is one atomic batch:
    // invitation -> USED, member document created, household.memberCount + 1.
    match /invitations/{invId} {
      allow get: if isAuthed();
      allow list: if isAuthed() && resource.data.createdByUserId == request.auth.uid;
      allow create: if isAuthed()
        && isOwner(request.resource.data.householdId)
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update: if isAuthed() && (
        // owner revokes
        (isOwner(resource.data.householdId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'REVOKED')
        ||
        // partner claims (single use, not expired)
        (resource.data.status == 'PENDING'
          && resource.data.expiresAt > request.time.toMillis()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedByUserId', 'usedAt'])
          && request.resource.data.status == 'USED'
          && request.resource.data.usedByUserId == request.auth.uid)
      );
    }

    function joinInvitationOk(hid, invId) {
      let inv = /databases/$(database)/documents/invitations/$(invId);
      return get(inv).data.householdId == hid
        && get(inv).data.status == 'PENDING'
        && get(inv).data.expiresAt > request.time.toMillis()
        && getAfter(inv).data.status == 'USED'
        && getAfter(inv).data.usedByUserId == request.auth.uid;
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if isAuthed()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.memberLimit == 2;
      allow update: if isAuthed() && (
        // owner: rename, remove member (memberCount - 1) ...
        (isOwner(hid)
          && request.resource.data.ownerUserId == resource.data.ownerUserId
          && request.resource.data.memberLimit == resource.data.memberLimit)
        ||
        // partner joining: count + 1 together with their own new member document
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && resource.data.memberCount < resource.data.memberLimit
          && !exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)))
        ||
        // partner leaving: count - 1 together with deleting their own member document
        (isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && !existsAfter(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)))
      );

      match /members/{memberUid} {
        allow read: if isMember(hid);
        // owner creating themselves together with the household
        allow create: if isAuthed()
          && request.auth.uid == memberUid
          && request.resource.data.role == 'OWNER'
          && request.resource.data.status == 'ACTIVE'
          && getAfter(/databases/$(database)/documents/households/$(hid)).data.ownerUserId == request.auth.uid;
        // partner joining with a valid single-use invitation
        allow create: if isAuthed()
          && request.auth.uid == memberUid
          && request.resource.data.role == 'MEMBER'
          && request.resource.data.status == 'ACTIVE'
          && joinInvitationOk(hid, request.resource.data.invitationId);
        // leaving (never the owner) or being removed by the owner
        allow delete: if isAuthed() && (
          (request.auth.uid == memberUid && resource.data.role == 'MEMBER')
          || (isOwner(hid) && memberUid != request.auth.uid)
        );
      }

      match /transactions/{docId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.householdId == hid;
        allow update: if isMember(hid)
          && request.resource.data.updatedByUserId == request.auth.uid;
      }

      match /wallets/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /categories/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /budgets/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /creditCards/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /emis/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }

      match /recurringTransactions/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.householdId == hid;
      }
    }
  }
}
